{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HiTech Client",
  "version": "0.1.0",
  "identifier": "tn.hitech.client",
  "build": {
    "frontendDist": "../../web",
    "devUrl": "http://127.0.0.1:8096",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "HiTech Client",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "url": "http://127.0.0.1:8096"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "HiTech Client Framework — universal AI client"
  }
}
